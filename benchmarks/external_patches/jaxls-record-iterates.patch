 _active_iteration_time_recorder: Any = None
 
 
+_active_iterate_recorder: Any = None
+
+
+@contextlib.contextmanager
+def record_iterates() -> Any:
+    """Record the variable values (a host-side `VarValues`) at the start of
+    the solve and after each outer LM iteration of any `solve()` traced in
+    this block, for convergence plots. As `record_iteration_times`, the
+    callback is decided at trace time: trace (jit) the solve inside the block.
+
+    Usage:
+        with jaxls.record_iterates() as iterates:
+            vals = problem.solve(...)
+        # [v[var] for v in iterates]  ->  the iterate sequence
+    """
+    global _active_iterate_recorder
+    prev, _active_iterate_recorder = _active_iterate_recorder, []
+    try:
+        yield _active_iterate_recorder
+    finally:
+        _active_iterate_recorder = prev
+
+
+def _record_iterate(vals) -> None:
+    """Hand `vals` to the active `record_iterates()` list (no-op otherwise)."""
+    if _active_iterate_recorder is None:
+        return
+    out = _active_iterate_recorder
+    jax.debug.callback(lambda v: out.append(jax.tree.map(onp.asarray, v)), vals, ordered=True)
+
+
